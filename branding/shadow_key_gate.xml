<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#09070D" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="28dp">
        <Space android:layout_width="1dp" android:layout_height="32dp" />
        <ImageView android:layout_width="108dp" android:layout_height="108dp"
            android:src="@mipmap/ic_launcher_foreground" android:contentDescription="Shadow Modz emblem" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Shadow Modz" android:textSize="32sp" android:textStyle="bold"
            android:textColor="#C084FC" android:gravity="center" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="LOCAL KEY" android:textSize="12sp" android:letterSpacing="0.15"
            android:textColor="#A855F7" android:gravity="center" android:layout_marginTop="8dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Enter your Shadow Modz key to continue." android:textColor="#DDD4E5"
            android:gravity="center" android:textSize="16sp" android:layout_marginTop="24dp" />
        <EditText android:id="@+id/shadow_key_input"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" android:singleLine="true" android:maxLength="128"
            android:hint="Licence key" android:textColor="#FFFFFF" android:textColorHint="#8D809C"
            android:backgroundTint="#A855F7" android:layout_marginTop="20dp" android:padding="14dp" />
        <TextView android:id="@+id/shadow_key_error"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FB7185" android:textSize="14sp" android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/shadow_key_continue"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Continue" android:textColor="#FFFFFF" android:backgroundTint="#7C3AED"
            android:layout_marginTop="12dp" android:minHeight="52dp" />
        <Button android:id="@+id/shadow_key_telegram"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Join Shadow Modz on Telegram" android:textColor="#DDD4E5"
            android:backgroundTint="#25172F" android:layout_marginTop="8dp" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Local-gate test only. Protected native engine licensing is unchanged. Startup and native features may still fail."
            android:textColor="#B9A7C7" android:textSize="12sp" android:gravity="center"
            android:layout_marginTop="24dp" android:padding="8dp" />
    </LinearLayout>
</ScrollView>
